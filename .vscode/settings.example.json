{
  "realtimeTex.serverPath": "",
  "realtimeTex.texliveBin": "",
  "realtimeTex.texDir": "",
  "realtimeTex.mainFile": "paper/main.tex",
  "realtimeTex.exportPath": "${mainDir}/output/${mainName}.pdf",
  "realtimeTex.autoStart": false,
  "realtimeTex.syncCursor": true,
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-lualatex",
      "command": "latexmk",
      "args": [
        "-cd",
        "-lualatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "LuaLaTeX (manual fallback)",
      "tools": [
        "latexmk-lualatex"
      ]
    }
  ],
  "[latex]": {
    "editor.wordWrap": "on",
    "editor.tabSize": 2
  },
  "files.exclude": {
    "**/*.synctex.gz": true
  },
  "files.watcherExclude": {
    "**/paper/build/**": true
  }
}
